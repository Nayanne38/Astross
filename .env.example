# Copy to .env and fill in. Never commit .env.
# Get a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# supabase (team database) | postgres (local docker-compose) | sqlite (offline fallback)
DB_BACKEND=sqlite
SQLITE_PATH=data/queimadas.db
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# Do NOT use the transaction pooler (6543): it breaks COPY/temp tables used by the loader.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local docker-compose:
# DATABASE_URL=postgresql://queimadas:queimadas@localhost:5432/queimadas
DATABASE_URL=

# Overrides config/settings.yaml default_region
REGION=

# API
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
